{
  "expo": {
    "name": "Savor IQ",
    "slug": "savor-iq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "savor-iq",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Savor IQ uses the camera to analyze meal photos for nutrition estimates.",
        "NSPhotoLibraryUsageDescription": "Savor IQ accesses your photo library so you can analyze meal photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Savor IQ to use your camera to analyze meal photos.",
          "photosPermission": "Allow Savor IQ to access your photos to analyze meals."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
